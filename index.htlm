<script type="pmdelayedscript" data-cfasync="false" data-no-optimize="1" data-no-defer="1" data-no-minify="1">!function(){const a=document.querySelectorAll(".has-custom-anchor");a.forEach(c=>{c.querySelectorAll("nav > a").forEach(a=>{a.href+="#"+c.attributes["data-anchor"].value})})}();</script>
<script type="pmdelayedscript" data-cfasync="false" data-no-optimize="1" data-no-defer="1" data-no-minify="1">
	(() => {
  const config = {
    maxSize: 1.4,
    minSize: 0.7,
    actualSize: 1,
    step: 0.1,

    textQuery: "h1,h2,h3,h4,h5,h6,p,a,li",
  };

  /**
   * Clamps a value between a min and max value.
   * @param {number} value The value to clamp.
   * @param {number} min
   * @param {number} max
   */
  function clamp(value, min, max) {
    return Math.min(Math.max(value, min), max);
  }

  /**
   * @param {-1 | 1} multiplier
   */
  function setFontSize(multiplier) {
    config.actualSize += config.step * multiplier;

    config.actualSize = clamp(
      config.actualSize,
      config.minSize,
      config.maxSize
    );

    const elements = document.querySelectorAll(config.textQuery);

    for (const element of elements) {
      if (element.tagName === "A") element.style.transition = "none";

      element.style.removeProperty("font-size");
      let { fontSize } = window.getComputedStyle(element);
      fontSize = parseFloat(fontSize) * config.actualSize + "px";
      element.style.fontSize = fontSize;
    }
  }

  function main() {
    const increaseButton = document.querySelector(".increase-font");
    const decreaseButton = document.querySelector(".decrease-font");

    increaseButton.onclick = () => setFontSize(1);
    decreaseButton.onclick = () => setFontSize(-1);
  }
  main();
})();

</script>

